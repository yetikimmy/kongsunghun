---
import BaseLayout from "../layouts/BaseLayout.astro";
import { LOGO_LABEL } from "../lib/nav";
import { relativeHref } from "../lib/href";

const here = Astro.url.pathname;
---

<BaseLayout title="KONG,SUNG-HUN" bare>
  <section class="landing">
    <header class="landing-header">
      <a class="landing-logo" href={relativeHref("/works/", here)}>{LOGO_LABEL}</a>
    </header>
    <div class="landing-media" aria-hidden="true">
      <video
        class="landing-video"
        src={relativeHref("/assets/landing/공성훈-추락.mp4", here)}
        autoplay
        muted
        loop
        playsinline
      ></video>
    </div>
  </section>
</BaseLayout>

<style>
  .landing {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background: #000;
    color: #fff;
    overflow: hidden;
  }
  .landing-header {
    position: relative;
    z-index: 10;
    padding: var(--space-4, 24px) var(--space-5, 40px);
    flex-shrink: 0;
    text-align: center;
  }
  .landing-logo {
    display: inline-block;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 28px;
    font-weight: 400;
    letter-spacing: 0.12em;
    color: #fff;
    text-decoration: none;
  }
  .landing-media {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    min-height: 0;
  }
  .landing-video {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    display: block;
  }
</style>
