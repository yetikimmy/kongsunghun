---
import BaseLayout from "../layouts/BaseLayout.astro";
import Logo from "../components/Logo.astro";
import { relativeHref } from "../lib/href";

const here = Astro.url.pathname;
---

<BaseLayout title="KONG,SUNG-HUN" bare>
  <section class="landing">
    <header class="landing-header">
      <a class="landing-logo" href={relativeHref("/works/", here)}><Logo /></a>
    </header>
    <div class="landing-media" aria-hidden="true">
      <video
        class="landing-video"
        src={relativeHref("/assets/landing/공성훈-추락.mp4", here)}
        autoplay
        muted
        loop
        playsinline
      ></video>
    </div>
  </section>
</BaseLayout>

<style>
  .landing {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background: #000;
    color: #fff;
    overflow: hidden;
  }
  .landing-header {
    position: relative;
    z-index: 10;
    padding: 90px var(--space-5, 40px) var(--space-4, 24px);
    flex-shrink: 0;
    text-align: center;
  }
  .landing-logo {
    display: inline-block;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 28px;
    font-weight: 400;
    letter-spacing: 0.12em;
    color: #fff;
    text-decoration: none;
  }
  .landing-media {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    min-height: 0;
  }
  .landing-video {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    display: block;
  }

  /* 모바일: 로고 상단 고정, 영상은 화면 세로 중앙으로 */
  @media (max-width: 768px) {
    .landing {
      position: relative;
    }
    .landing-header {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      /* 로고 살짝 아래로 */
      padding-top: 130px;
    }
    .landing-logo {
      /* 로고 살짝 작게 */
      font-size: 24px;
    }
    .landing-media {
      position: absolute;
      inset: 0;
      /* 영상을 화면 세로 중앙보다 살짝 위로 */
      transform: translateY(-24px);
    }
  }
</style>
