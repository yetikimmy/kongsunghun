---
import BaseLayout from "../layouts/BaseLayout.astro";
import { LOGO_LABEL, MAIN_NAV } from "../lib/nav";
import { relativeHref } from "../lib/href";

const here = Astro.url.pathname;
---

<BaseLayout title="KONG,SUNG-HUN" bare>
  <section class="landing">
    <div class="landing-media" aria-hidden="true">
      <!-- Placeholder: replace with <video> once cover.mp4 is provided -->
    </div>
    <div class="landing-center">
      <a class="landing-logo" href={relativeHref("/works/", here)}>{LOGO_LABEL}</a>
      <nav class="landing-nav" aria-label="주 메뉴">
        <ul>
          {MAIN_NAV.map((item) => <li><a href={relativeHref(item.href, here)}>{item.label}</a></li>)}
        </ul>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  /* Literal fallbacks in var() keep the landing legible even if the bundled
     token stylesheet fails to load (e.g. a sub-path deploy regression). */
  .landing {
    position: relative;
    min-height: 100vh;
    background: var(--color-bg-invert, #000000);
    color: var(--color-fg-invert, #ffffff);
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .landing-media {
    position: absolute;
    inset: 0;
    background: #111;
  }
  .landing-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .landing-center {
    position: relative;
    text-align: center;
    padding: var(--space-5, 40px);
  }
  .landing-logo {
    display: inline-block;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: clamp(28px, 6vw, var(--fs-logo-landing, 38px));
    letter-spacing: var(--ls-logo-landing, 6.08px);
    color: var(--color-fg-invert, #ffffff);
    text-decoration: none;
  }
  .landing-logo:hover,
  .landing-logo:focus-visible {
    opacity: 0.7;
  }
  .landing-nav ul {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-3, 16px) var(--space-5, 40px);
    list-style: none;
    margin: var(--space-5, 40px) 0 0;
    padding: 0;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--fs-nav, 14px);
  }
  .landing-nav a {
    color: inherit;
    text-decoration: none;
  }
  .landing-nav a:hover,
  .landing-nav a:focus-visible {
    text-decoration: underline;
  }
</style>
