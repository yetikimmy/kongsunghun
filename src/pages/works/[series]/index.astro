---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import WorkGrid from "../../../components/WorkGrid.astro";
import WorkDetail from "../../../components/WorkDetail.astro";
import LangToggle from "../../../components/LangToggle.astro";
import { WORK_CATEGORIES } from "../../../lib/nav";
import { relativeHref } from "../../../lib/href";
import { groupWorks, mergeWorks, isSinglePageSeries } from "../../../lib/works";

export async function getStaticPaths() {
  const SERIES_COLUMNS: Record<string, number> = {
    "installation-work": 5,
    "multi-slide-projection": 4,
    "paintings": 2,
  };
  const SERIES_LAYOUT: Record<string, "grid" | "square-grid" | "list"> = {
    "multi-slide-projection": "square-grid",
    "paintings": "list",
  };
  const SERIES_LANG_TOGGLE: Record<string, boolean> = {
    "installation-work": true,
    "paintings": true,
  };
  const all = await getCollection("works");
  // paintings: 작품이 존재하는 연도 목록 (연도별 페이지 링크용)
  const paintingYears = [
    ...new Set(
      all
        .filter((w) => w.data.series === "paintings" && w.data.year)
        .map((w) => w.data.year as number),
    ),
  ].sort((a, b) => a - b);
  return WORK_CATEGORIES.map((cat) => {
    const entries = all.filter((w) => w.data.series === cat.series);
    const single = isSinglePageSeries(cat.series);
    return {
      params: { series: cat.series },
      props: {
        label: cat.label,
        series: cat.series,
        single,
        columns: SERIES_COLUMNS[cat.series] ?? 3,
        layout: SERIES_LAYOUT[cat.series] ?? "grid",
        showLangToggle: SERIES_LANG_TOGGLE[cat.series] ?? false,
        groups: single ? [] : groupWorks(entries),
        merged: single ? mergeWorks(entries, cat.series) : null,
        years: cat.series === "paintings" ? paintingYears : [],
      },
    };
  });
}

const { label, series, single, groups, merged, columns, layout, showLangToggle, years } =
  Astro.props;
const here = Astro.url.pathname;
// 연도 나열 범위 (1990–2019). 작품이 있는 연도만 링크로 활성화.
const YEAR_RANGE = Array.from({ length: 2019 - 1990 + 1 }, (_, i) => 1990 + i);
const yearSet = new Set<number>(years ?? []);
---

<BaseLayout title={`${label} — KONG,SUNG-HUN`} current="/works/">
  <div class="container cat-index">
    {
      single && merged ? (
        <WorkDetail group={merged} backHref="/works/" singlePage={true} />
      ) : (
        <div data-lang-scope={showLangToggle || undefined}>
          <div class="cat-head">
            <h1 class="title cat-title">{label}</h1>
            {showLangToggle && <LangToggle />}
          </div>
          {groups.length > 0 ? (
            <WorkGrid groups={groups} columns={columns} layout={layout} showLangToggle={showLangToggle} />
          ) : (
            <p class="caption empty">아직 등록된 작업이 없습니다.</p>
          )}

          {series === "paintings" && (
            <nav class="year-nav" aria-label="연도별 작품">
              {YEAR_RANGE.map((y) =>
                yearSet.has(y) ? (
                  <a class="year-link" href={relativeHref(`/works/paintings/year/${y}/`, here)}>
                    {y}
                  </a>
                ) : (
                  <span class="year-link year-link--empty">{y}</span>
                ),
              )}
            </nav>
          )}
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  .cat-index {
    padding-top: var(--page-top);
    padding-bottom: var(--space-7);
  }
  .cat-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .cat-title {
    font-size: clamp(18px, 3vw, 28px);
    margin-bottom: var(--space-5);
  }
  .empty {
    margin-top: var(--space-5);
  }

  /* 연도별 작품 네비게이션 (썸네일 리스트 아래) */
  .year-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55em 0.9em;
    margin-top: var(--space-7);
  }
  .year-link {
    font-family: var(--font-display);
    font-size: clamp(15px, 2.4vw, 22px);
    line-height: 1.2;
    color: var(--color-fg);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  a.year-link:hover {
    color: var(--color-nav-hover);
  }
  /* 작품이 없는 연도는 흐리게(비활성) */
  .year-link--empty {
    color: #d0d0d0;
    pointer-events: none;
  }
</style>
