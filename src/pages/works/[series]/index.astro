---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import WorkGrid from "../../../components/WorkGrid.astro";
import { WORK_CATEGORIES } from "../../../lib/nav";
import { groupWorks } from "../../../lib/works";

export async function getStaticPaths() {
  const all = await getCollection("works");
  return WORK_CATEGORIES.map((cat) => ({
    params: { series: cat.series },
    props: {
      label: cat.label,
      series: cat.series,
      groups: groupWorks(all.filter((w) => w.data.series === cat.series)),
    },
  }));
}

const { label, groups } = Astro.props;
---

<BaseLayout title={`${label} — KONG,SUNG-HUN`} current="/works/">
  <div class="container cat-index">
    <h1 class="title cat-title">{label}</h1>
    {
      groups.length > 0 ? (
        <WorkGrid groups={groups} />
      ) : (
        <p class="caption empty">아직 등록된 작업이 없습니다.</p>
      )
    }
  </div>
</BaseLayout>

<style>
  .cat-index {
    padding-block: var(--space-5);
  }
  .cat-title {
    font-size: clamp(18px, 3vw, 28px);
    margin-bottom: var(--space-5);
  }
  .empty {
    margin-top: var(--space-5);
  }
</style>
