---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LangToggle from "../../components/LangToggle.astro";
import overview from "../../../data/works-overview.generated.json";

// Works landing essay "20세기, 라는 소년 / A BOY CALLED THE 20TH CENTURY"
// (황세준, 월간미술 2007.3). Korean and English are full independent blocks;
// the LangToggle shows one at a time (Korean default). The bilingual title is
// always shown (영문/국문 병기), matching the Figma "Landing Page_Essay" frame.
const blocks = [
  { lang: "ko" as const, body: overview.ko },
  { lang: "en" as const, body: overview.en },
];

// 문단 시작 넘버링("1.", "2." …)에서 뒤의 "." 기호를 제거해 "1", "2" 로 표시.
const stripNumberDot = (t: string) => t.replace(/^(\s*\d+)\.\s*$/, "$1");

// 본문 속 꺾쇠 제목(<호수공원> 등)이 줄바꿈으로 쪼개지지 않도록, 해당 토큰만
// 분리해 nowrap 으로 감싸고 앞에 줄바꿈 기회(ZWSP)를 둔다.
const segmentBrackets = (text: string) => text.split(/(<[^>]+>)/).filter((s) => s !== "");
const isBracket = (s: string) => /^<[^>]+>$/.test(s);

// 연속된 signature 블록(작가명 / 매체출처)을 한 문단으로 합쳐, 블록 간 간격 없이
// 바로 다음 줄에 붙도록 한다.
const groupSignatures = (arr: any[]) => {
  const out: any[] = [];
  for (const b of arr) {
    const last = out[out.length - 1];
    if (b.kind === "signature" && last && last.kind === "signature") {
      last.lines.push(b.text);
    } else if (b.kind === "signature") {
      out.push({ kind: "signature", lines: [b.text] });
    } else {
      out.push(b);
    }
  }
  return out;
};
---

<BaseLayout title="WORKS — KONG,SUNG-HUN" current="/works/">
  <div class="container works-overview" data-lang-scope>
    <div class="overview-head">
      <h1 class="overview-title">
        <span class="title-ko">{overview.titleKo}</span>
        <span class="title-en">{overview.titleEn}</span>
      </h1>
      <LangToggle />
    </div>

    {
      blocks.map(({ lang, body }) => (
        <div
          class="overview-body"
          lang={lang === "ko" ? "ko" : "en"}
          data-lang={lang}
          hidden={lang !== "ko"}
        >
          {groupSignatures(body).map((b) =>
            b.kind === "heading" ? (
              <h2 class="body-heading">{stripNumberDot(b.text)}</h2>
            ) : b.kind === "figure" ? (
              <figure class="body-figure">
                {b.img && <img src={b.img} alt={b.caption} loading="lazy" />}
                <figcaption class="body-caption">{b.caption}</figcaption>
              </figure>
            ) : b.kind === "signature" ? (
              <p class="body-signature">
                {b.lines.map((l: string, i: number) =>
                  i === 0 ? l : (
                    <>
                      <br />
                      {l}
                    </>
                  ),
                )}
              </p>
            ) : (
              <p class="body-para">
                {segmentBrackets(b.text).map((seg) =>
                  isBracket(seg) ? (
                    <>
                      {"​"}
                      <span class="nowrap">{seg}</span>
                    </>
                  ) : (
                    seg
                  ),
                )}
              </p>
            ),
          )}
        </div>
      ))
    }
  </div>
</BaseLayout>

<style>
  .works-overview {
    padding-top: var(--page-top);
    padding-bottom: var(--space-7);
  }
  .overview-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .overview-title {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 1.2;
    margin: 0;
  }
  .title-ko,
  .title-en {
    font-size: var(--fs-page-title);
    line-height: var(--lh-page-title);
    color: var(--color-fg);
    white-space: pre-line;
  }
  .overview-body {
    margin: var(--space-6) 0 0;
    max-width: 1000px;
    color: #8c8c8c;
    font-size: 13px;
    line-height: calc(var(--lh-body) + 1px);
    word-break: keep-all;
    overflow-wrap: break-word;
  }
  .body-heading {
    font-family: var(--font-display);
    font-size: 16px;
    color: var(--color-fg);
    margin: var(--space-5) 0 calc(var(--space-3) - 4px);
  }
  /* 새 넘버 문단 시작 시 한 줄 더 띄움 (첫 넘버는 제외) */
  .body-heading:not(:first-child) {
    margin-top: calc(var(--space-5) + 25px);
  }
  .body-para + .body-para,
  .body-para + .body-caption {
    margin-top: var(--space-3);
  }
  .body-figure {
    margin: var(--space-5) 0;
  }
  .body-figure img {
    width: 100%;
    max-width: 496px;
    height: auto;
    display: block;
  }
  .body-caption {
    color: var(--color-muted);
    font-style: normal;
    font-size: 11px;
    /* Blind Work 캡션과 동일하게 타이트한 행간으로 사진과 붙임 */
    line-height: 14px;
    margin-top: var(--space-2);
  }
  .body-signature {
    /* 마지막 문단과 서명 사이 세 줄 정도 간격 */
    margin-top: 72px;
    text-align: right;
    color: var(--color-muted);
    line-height: 18px;
  }
  /* 꺾쇠 제목(<호수공원> 등)이 중간에 잘리지 않도록 */
  .nowrap {
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .works-overview {
      padding-bottom: var(--space-5);
    }
  }
</style>
