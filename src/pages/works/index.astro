---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LangToggle from "../../components/LangToggle.astro";
import overview from "../../../data/works-overview.generated.json";

// Works landing essay "20세기, 라는 소년 / A BOY CALLED THE 20TH CENTURY"
// (황세준, 월간미술 2007.3). Korean and English are full independent blocks;
// the LangToggle shows one at a time (Korean default). The bilingual title is
// always shown (영문/국문 병기), matching the Figma "Landing Page_Essay" frame.
const blocks = [
  { lang: "ko" as const, body: overview.ko },
  { lang: "en" as const, body: overview.en },
];
---

<BaseLayout title="WORKS — KONG,SUNG-HUN" current="/works/">
  <div class="container works-overview" data-lang-scope>
    <div class="overview-head">
      <h1 class="overview-title">
        <span class="title-ko">{overview.titleKo}</span>
        <span class="title-en">{overview.titleEn}</span>
      </h1>
      <LangToggle />
    </div>

    {
      blocks.map(({ lang, body }) => (
        <div
          class="overview-body"
          lang={lang === "ko" ? "ko" : "en"}
          data-lang={lang}
          hidden={lang !== "ko"}
        >
          {body.map((b) =>
            b.kind === "heading" ? (
              <h2 class="body-heading">{b.text}</h2>
            ) : b.kind === "caption" ? (
              <p class="body-caption">{b.text}</p>
            ) : b.kind === "signature" ? (
              <p class="body-signature">{b.text}</p>
            ) : (
              <p class="body-para">{b.text}</p>
            ),
          )}
        </div>
      ))
    }
  </div>
</BaseLayout>

<style>
  .works-overview {
    padding-block: var(--space-7);
  }
  .overview-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .overview-title {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 1.2;
    margin: 0;
  }
  .title-ko,
  .title-en {
    font-size: clamp(18px, 2.5vw, 28px);
    color: var(--color-fg);
  }
  .overview-body {
    margin: var(--space-6) 0 0;
    max-width: 1000px;
    color: #a0a0a0;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }
  .body-heading {
    font-family: var(--font-display);
    font-size: 16px;
    color: var(--color-fg);
    margin: var(--space-5) 0 var(--space-3);
  }
  .body-para + .body-para,
  .body-para + .body-caption {
    margin-top: var(--space-3);
  }
  .body-caption {
    color: var(--color-muted);
    font-style: italic;
    margin: var(--space-3) 0;
  }
  .body-signature {
    margin-top: var(--space-2);
    text-align: right;
    color: var(--color-muted);
  }
  .body-signature:first-of-type {
    margin-top: var(--space-5);
  }

  @media (max-width: 768px) {
    .works-overview {
      padding-block: var(--space-5);
    }
  }
</style>
