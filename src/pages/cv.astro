---
import BaseLayout from "../layouts/BaseLayout.astro";
import LangToggle from "../components/LangToggle.astro";
import pages from "../../data/legacy-pages.generated.json";

// The Korean (cv.htm) and English (cv02.htm) CVs are rendered as two complete,
// independent blocks; the LangToggle shows one at a time (Korean default).
const { ko, en } = pages.cv;

const blocks = [
  { lang: "ko" as const, cv: ko },
  { lang: "en" as const, cv: en },
];
---

<BaseLayout title="C.V. — KONG,SUNG-HUN" current="/cv/">
  <div class="container cv-page" data-lang-scope>
    <div class="cv-head">
      <h1 class="title">C.V.</h1>
      <LangToggle />
    </div>

    {
      blocks.map(({ lang, cv }) => (
        <div class="cv-block" lang={lang === "ko" ? "ko" : "en"} data-lang={lang} hidden={lang !== "ko"}>
          {cv.intro && <p class="bio">{cv.intro}</p>}
          {cv.sections.map((s) => (
            <section class="cv-section">
              <h2 class="cv-heading">{s.heading}</h2>
              <ul class="cv-list" role="list">
                {s.items.map((item) => (
                  <li class="cv-item">{item}</li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      ))
    }
  </div>
</BaseLayout>

<style>
  .cv-page {
    padding-top: var(--page-top);
    padding-bottom: var(--space-6);
  }
  .cv-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .bio {
    margin: var(--space-4) 0 var(--space-5);
    color: var(--color-muted);
  }
  .cv-section {
    margin-top: var(--space-5);
  }
  .cv-heading {
    font-family: var(--font-mono);
    font-size: var(--fs-nav);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-line);
  }
  .cv-list {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
  }
  .cv-item {
    padding-block: var(--space-2);
    max-width: 80ch;
  }
  .cv-item + .cv-item {
    border-top: 1px solid var(--color-line);
  }
</style>
