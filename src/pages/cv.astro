---
import BaseLayout from "../layouts/BaseLayout.astro";
import LangToggle from "../components/LangToggle.astro";
import pages from "../../data/legacy-pages.generated.json";

const { ko, en } = pages.cv;

const blocks = [
  { lang: "ko" as const, cv: ko },
  { lang: "en" as const, cv: en },
];

// 항목이 4자리 연도로 시작하면 연도와 내용을 분리해 사이 간격(15px)을 준다.
const splitYear = (item: string) => {
  const m = item.match(/^(\d{4})\s+([\s\S]*)$/);
  return m ? { year: m[1], desc: m[2] } : null;
};
---

<BaseLayout title="C.V. — KONG,SUNG-HUN" current="/cv/">
  <div class="container cv-page" data-lang-scope>
    <div class="cv-layout">
      <div class="cv-content">
        <h1 class="title">C.V.</h1>

        {
          blocks.map(({ lang, cv }) => (
            <div class="cv-block" lang={lang === "ko" ? "ko" : "en"} data-lang={lang} hidden={lang !== "ko"}>
              {cv.intro && <p class="bio">{cv.intro}</p>}
              {cv.sections.map((s) => (
                <section class="cv-section">
                  <h2 class="cv-heading">{s.heading}</h2>
                  <ul class="cv-list" role="list">
                    {s.items.map((item) => {
                      const p = splitYear(item);
                      return p ? (
                        <li class="cv-item">
                          <span class="cv-year">{p.year}</span>
                          <span class="cv-desc">{p.desc}</span>
                        </li>
                      ) : (
                        <li class="cv-item cv-item--plain">{item}</li>
                      );
                    })}
                  </ul>
                </section>
              ))}
            </div>
          ))
        }
      </div>

      <div class="cv-toggle">
        <LangToggle />
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .cv-page {
    padding-top: var(--page-top);
    padding-bottom: var(--space-6);
  }
  .cv-layout {
    display: flex;
    align-items: flex-start;
    gap: 0;
  }
  .cv-content {
    flex: 0 0 830px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .cv-toggle {
    flex: 1;
    display: flex;
    justify-content: center;
    padding-top: 6px;
  }
  .title {
    font-family: var(--font-display);
    font-size: clamp(18px, 2.4vw, 28px);
    font-weight: 600;
    line-height: 1.25;
  }
  .bio {
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: 12.5px;
    line-height: 19px;
    margin: 0;
  }
  .cv-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .cv-section {
    display: flex;
    flex-direction: column;
    /* 섹션 제목 ↔ 본문(연도 항목) 사이 간격 */
    gap: 6px;
  }
  .cv-heading {
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 700;
    line-height: 19px;
    color: var(--color-muted);
  }
  .cv-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .cv-item {
    display: flex;
    font-family: var(--font-body);
    font-size: 12.5px;
    line-height: 19px;
    color: var(--color-muted);
  }
  .cv-item--plain {
    display: block;
  }
  /* 연도와 내용 사이 간격 15px (내용이 여러 줄이면 연도 기준 hanging indent) */
  .cv-year {
    flex: none;
    margin-right: 15px;
    /* 모든 연도가 4자리이므로 등폭 숫자로 폭을 통일 → 내용 시작점 일직선 정렬 */
    font-variant-numeric: tabular-nums;
  }
  .cv-desc {
    flex: 1;
    min-width: 0;
  }

  @media (max-width: 1024px) {
    .cv-content {
      flex: 1;
    }
    .cv-toggle {
      flex: 0 0 auto;
    }
  }
  @media (max-width: 768px) {
    .cv-layout {
      flex-direction: column;
      gap: var(--space-4);
    }
    .cv-toggle {
      justify-content: flex-start;
    }
  }
</style>
