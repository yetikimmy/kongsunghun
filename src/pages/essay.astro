---
import BaseLayout from "../layouts/BaseLayout.astro";
import LangToggle from "../components/LangToggle.astro";
import pages from "../../data/legacy-pages.generated.json";

// Interview-form artist essay (1998). Korean is the primary text (essay.htm),
// English the translation (essay02.htm). The LangToggle shows one block at a
// time (Korean default); the bilingual title is always shown (영문/국문 병기),
// matching the Works landing title format.
const { ko, en } = pages.essay;

// Title broken across fixed lines (Korean 2 lines, English 3 lines).
const TITLE_KO_LINES = ["미술관계자의 변명-", "나와의 인터뷰"];
const TITLE_EN_LINES = ["EXCUSES OF SOMEONE", "CONCERNED WITH ART-", "INTERVIEW WITH MYSELF"];

const blocks = [
  { lang: "ko" as const, essay: ko },
  { lang: "en" as const, essay: en },
];

// 문단 시작 넘버링("1.", "2." …)에서 뒤의 "." 기호를 제거해 "1", "2" 로 표시.
const stripNumberDot = (t: string) => t.replace(/^(\s*\d+)\.\s*$/, "$1");

// 대화 문단("* 공을 : …", "* 공갑 : …")에서 앞의 "*" 를 떼고 화자 이름을 분리한다.
const dialogue = (text: string) => {
  const m = text.match(/^\*\s*([^:]+?)\s*:\s*([\s\S]*)$/);
  return m ? { speaker: m[1], rest: m[2] } : null;
};
---

<BaseLayout title="ESSAY — KONG,SUNG-HUN" current="/essay/">
  <div class="container essay-page" data-lang-scope>
    <div class="essay-head">
      <h1 class="essay-title">
        <span class="title-ko">
          {TITLE_KO_LINES.map((line, i) => (
            <>{i > 0 && <br />}{line}</>
          ))}
        </span>
        <span class="title-en">
          {TITLE_EN_LINES.map((line, i) => (
            <>{i > 0 && <br />}{line}</>
          ))}
        </span>
      </h1>
      <LangToggle />
    </div>

    {
      blocks.map(({ lang, essay }) => (
        <article
          class="essay-block"
          lang={lang === "ko" ? "ko" : "en"}
          data-lang={lang}
          hidden={lang !== "ko"}
        >
          {essay.paragraphs.map((p) => {
            if (p.kind === "heading")
              return <h2 class="essay-heading">{stripNumberDot(p.text)}</h2>;
            if (p.kind === "signature")
              return <p class="essay-signature">{p.text}</p>;
            const d = dialogue(p.text);
            return d ? (
              <p class="essay-para">
                <strong class="speaker">{d.speaker}</strong>{d.rest}
              </p>
            ) : (
              <p class="essay-para">{p.text}</p>
            );
          })}
        </article>
      ))
    }
  </div>
</BaseLayout>

<style>
  .essay-page {
    padding-top: var(--page-top);
    padding-bottom: var(--space-7);
  }
  .essay-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .essay-title {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 1.2;
    margin: 0;
    max-width: 1000px;
  }
  .title-ko,
  .title-en {
    font-size: var(--fs-page-title);
    line-height: var(--lh-page-title);
    color: var(--color-fg);
  }
  .essay-block {
    margin-top: var(--space-6);
    max-width: 1000px;
    color: #8c8c8c;
    font-size: 13px;
    line-height: calc(var(--lh-body) + 1px);
    word-break: keep-all;
    overflow-wrap: break-word;
  }
  .essay-heading {
    font-family: var(--font-display);
    font-size: 16px;
    color: var(--color-fg);
    margin-top: var(--space-5);
    margin-bottom: calc(var(--space-3) - 4px);
  }
  /* 앞 문단 뒤에 오는 다음 넘버 문단 간격 (첫 넘버는 제외) */
  .essay-para + .essay-heading {
    margin-top: calc(var(--space-5) + 25px);
  }
  .essay-para {
    margin: var(--space-3) 0;
  }
  /* 대화 화자(공을 / 공갑 …) 볼드 + ":" 대신 살짝 넓힌 간격으로 내용과 분리 */
  .essay-para .speaker {
    font-weight: 700;
    margin-right: 14px;
  }
  .essay-signature {
    /* 본문 마지막 문장과 작가 이름 사이 2줄 더 띄움 */
    margin-top: calc(var(--space-5) + 50px);
    color: var(--color-muted);
    text-align: right;
    white-space: pre-line;
  }

  @media (max-width: 768px) {
    .essay-page {
      padding-bottom: var(--space-5);
    }
  }
</style>
