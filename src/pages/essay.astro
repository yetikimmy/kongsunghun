---
import BaseLayout from "../layouts/BaseLayout.astro";
import LangToggle from "../components/LangToggle.astro";
import pages from "../../data/legacy-pages.generated.json";

// Interview-form artist essay (1998). Korean is the primary text (essay.htm),
// English the translation (essay02.htm). The LangToggle shows one block at a
// time (Korean default); the bilingual title is always shown (영문/국문 병기),
// matching the Works landing title format.
const { ko, en } = pages.essay;

// Title broken across fixed lines (Korean 2 lines, English 3 lines).
const TITLE_KO_LINES = ["미술관계자의 변명-", "나와의 인터뷰"];
const TITLE_EN_LINES = ["EXCUSES OF SOMEONE", "CONCERNED WITH ART-", "INTERVIEW WITH MYSELF"];

const blocks = [
  { lang: "ko" as const, essay: ko },
  { lang: "en" as const, essay: en },
];

// 문단 시작 넘버링("1.", "2." …)에서 뒤의 "." 기호를 제거해 "1", "2" 로 표시.
const stripNumberDot = (t: string) => t.replace(/^(\s*\d+)\.\s*$/, "$1");
---

<BaseLayout title="ESSAY — KONG,SUNG-HUN" current="/essay/">
  <div class="container essay-page" data-lang-scope>
    <div class="essay-head">
      <h1 class="essay-title">
        <span class="title-ko">
          {TITLE_KO_LINES.map((line, i) => (
            <>{i > 0 && <br />}{line}</>
          ))}
        </span>
        <span class="title-en">
          {TITLE_EN_LINES.map((line, i) => (
            <>{i > 0 && <br />}{line}</>
          ))}
        </span>
      </h1>
      <LangToggle />
    </div>

    {
      blocks.map(({ lang, essay }) => (
        <article
          class="essay-block"
          lang={lang === "ko" ? "ko" : "en"}
          data-lang={lang}
          hidden={lang !== "ko"}
        >
          {essay.paragraphs.map((p) =>
            p.kind === "heading" ? (
              <h2 class="essay-heading">{stripNumberDot(p.text)}</h2>
            ) : p.kind === "signature" ? (
              <p class="essay-signature">{p.text}</p>
            ) : (
              <p class="essay-para">{p.text}</p>
            ),
          )}
        </article>
      ))
    }
  </div>
</BaseLayout>

<style>
  .essay-page {
    padding-top: var(--page-top);
    padding-bottom: var(--space-7);
  }
  .essay-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .essay-title {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 1.2;
    margin: 0;
    max-width: 1000px;
  }
  .title-ko,
  .title-en {
    font-size: var(--fs-page-title);
    line-height: var(--lh-page-title);
    color: var(--color-fg);
  }
  .essay-block {
    margin-top: var(--space-6);
    max-width: 1000px;
    color: #8c8c8c;
    font-size: 12px;
    line-height: var(--lh-body);
  }
  .essay-heading {
    font-family: var(--font-display);
    font-size: 16px;
    color: var(--color-fg);
    margin-top: var(--space-5);
    margin-bottom: calc(var(--space-3) - 4px);
  }
  .essay-para {
    margin: var(--space-3) 0;
  }
  .essay-signature {
    margin-top: var(--space-5);
    color: var(--color-muted);
    text-align: right;
  }

  @media (max-width: 768px) {
    .essay-page {
      padding-bottom: var(--space-5);
    }
  }
</style>
