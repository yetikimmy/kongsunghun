---
/**
 * 언어 전환 (단일 버튼 토글).
 * 버튼에는 "전환할 언어"가 표시된다:
 *   - 본문이 한글일 때  → 버튼 "ENGLISH" (누르면 영어로)
 *   - 본문이 영어일 때  → 버튼 "KOREAN"  (누르면 한글로)
 * data-lang-scope 조상 안의 [data-lang="ko"|"en"] 요소 표시를 토글한다. 한글 기본.
 */
---

<div class="lang-toggle">
  <button type="button" class="lang-btn" aria-label="언어 전환">ENGLISH</button>
</div>

<style>
  .lang-toggle {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-display);
    font-size: 10.5px;
    text-transform: uppercase;
  }
  .lang-btn {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: inherit;
    font-size: inherit;
    color: var(--color-nav-default);
    transition: color 0.15s;
  }
  .lang-btn:hover {
    color: var(--color-nav-pressed);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".lang-toggle").forEach((toggle) => {
    const scope =
      toggle.closest<HTMLElement>("[data-lang-scope]") ?? document.body;
    const btn = toggle.querySelector<HTMLButtonElement>(".lang-btn");
    if (!btn) return;

    let current = "ko";

    function apply(lang: string) {
      scope.querySelectorAll<HTMLElement>("[data-lang]").forEach((el) => {
        el.hidden = el.dataset.lang !== lang;
      });
      current = lang;
      // 버튼에는 '전환할' 언어를 표시
      btn!.textContent = lang === "ko" ? "ENGLISH" : "KOREAN";
    }

    btn.addEventListener("click", () => apply(current === "ko" ? "en" : "ko"));
    apply("ko");
  });
</script>
