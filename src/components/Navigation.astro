---
import { MAIN_NAV } from "../lib/nav";

interface Props {
  current?: string;
}
const { current } = Astro.props;
---

<nav class="nav" aria-label="주 메뉴">
  <ul>
    {
      MAIN_NAV.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={current && item.href.startsWith(current) ? "page" : undefined}
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .nav ul {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-nav);
  }
  .nav a[aria-current="page"] {
    text-decoration: underline;
  }
  @media (max-width: 768px) {
    .nav ul {
      gap: var(--space-3);
      flex-wrap: wrap;
    }
  }
</style>
