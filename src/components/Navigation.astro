---
import { MAIN_NAV, WORK_CATEGORIES } from "../lib/nav";
import { relativeHref } from "../lib/href";

interface Props {
  current?: string;
}
const { current } = Astro.props;
const here = Astro.url.pathname;
const currentSeries = WORK_CATEGORIES.find((c) => here.startsWith(c.href))?.series;
---

<nav class="nav" aria-label="주 메뉴">
  <ul>
    {
      MAIN_NAV.map((item) => {
        const isCurrent = current && item.href.startsWith(current);
        const hasDropdown = item.label === "WORKS";
        return (
          <li class:list={["nav-item", { "has-dropdown": hasDropdown }]}>
            <a
              href={relativeHref(item.href, here)}
              aria-current={isCurrent ? "page" : undefined}
              aria-expanded={hasDropdown ? "false" : undefined}
            >
              {item.label}
            </a>
            {hasDropdown && (
              <div class="dropdown" aria-label="작업 카테고리">
                <ul>
                  {WORK_CATEGORIES.map((cat) => (
                    <li>
                      <a
                        class:list={["tab", { active: currentSeries === cat.series }]}
                        href={relativeHref(cat.href, here)}
                      >
                        {cat.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        );
      })
    }
  </ul>
</nav>

<style>
  .nav ul {
    display: flex;
    gap: 36px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-nav);
  }
  .nav-item {
    position: relative;
  }
  .nav a {
    color: var(--color-nav-default);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .nav a:hover,
  .nav a:focus-visible {
    color: var(--color-nav-hover);
    text-decoration: none;
  }
  .nav a:active,
  .nav a[aria-current="page"] {
    color: var(--color-nav-pressed);
  }

  /* ── WORKS 드롭다운 ── */
  .dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    padding-top: var(--space-2);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.15s ease;
    white-space: nowrap;
    z-index: 100;
  }
  .nav-item.has-dropdown:hover .dropdown,
  .nav-item.has-dropdown:focus-within .dropdown,
  .nav-item.has-dropdown.open .dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  .nav-item.has-dropdown > a {
    padding-bottom: var(--space-2);
    margin-bottom: calc(-1 * var(--space-2));
  }
  .dropdown ul {
    display: flex;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .dropdown .tab {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    width: 160px;
    height: 18px;
    padding: 0 0 0 4px;
    background: var(--color-tab-bg);
    color: var(--color-tab-text);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--fs-tab);
    letter-spacing: normal;
    transition: background 0.1s, color 0.1s;
    white-space: nowrap;
  }
  .dropdown .tab:hover {
    background: var(--color-tab-bg-active);
    color: var(--color-tab-text-active);
    text-decoration: none;
  }
  .dropdown .tab.active {
    background: var(--color-tab-bg-active);
    color: var(--color-tab-text-active);
  }

  /* ── 모바일 (768px 이하): 로고 아래 인라인 네비게이션 ── */
  @media (max-width: 768px) {
    .nav {
      width: 100%;
    }
    .nav ul {
      gap: var(--space-4);
      font-size: 13px;
      flex-wrap: wrap;
    }

    /* WORKS 드롭다운: 탭하면 아래로 펼쳐짐 */
    .dropdown {
      position: static;
      padding-top: 0;
      transition: none;
      white-space: normal;
    }
    /* 기본은 접힘, WORKS 항목을 탭해 .open이 되면 펼쳐짐 */
    .nav-item.has-dropdown .dropdown {
      display: none;
    }
    .nav-item.has-dropdown.open .dropdown {
      display: block;
    }
    .nav-item.has-dropdown > a {
      padding-bottom: 0;
      margin-bottom: 0;
    }
    .dropdown ul {
      flex-direction: column;
      gap: var(--space-2);
      padding-top: var(--space-2);
    }
    .dropdown .tab {
      width: auto;
      height: auto;
      padding: var(--space-1) var(--space-2);
      font-size: 13px;
    }
  }
</style>

<script>
  // 모바일(터치)에서 WORKS 탭을 누르면 하위 드롭다운을 펼치거나 접는다.
  // 데스크탑에서는 hover로 동작하므로 이 핸들러는 좁은 화면에서만 링크 이동을 가로챈다.
  const MOBILE = "(max-width: 768px)";

  document.querySelectorAll<HTMLElement>(".nav-item.has-dropdown").forEach((item) => {
    const trigger = item.querySelector<HTMLAnchorElement>(":scope > a");
    if (!trigger) return;

    trigger.addEventListener("click", (e) => {
      if (!window.matchMedia(MOBILE).matches) return; // 데스크탑은 기본 링크 동작
      const isOpen = item.classList.contains("open");
      if (!isOpen) {
        // 첫 탭: 링크 이동 대신 드롭다운 펼치기
        e.preventDefault();
        item.classList.add("open");
        trigger.setAttribute("aria-expanded", "true");
      }
      // 이미 열려 있으면 그대로 링크(WORKS 인덱스)로 이동
    });
  });

  // 바깥 영역을 탭하면 드롭다운 닫기
  document.addEventListener("click", (e) => {
    if (!window.matchMedia(MOBILE).matches) return;
    document.querySelectorAll<HTMLElement>(".nav-item.has-dropdown.open").forEach((item) => {
      if (!item.contains(e.target as Node)) {
        item.classList.remove("open");
        item.querySelector<HTMLAnchorElement>(":scope > a")?.setAttribute("aria-expanded", "false");
      }
    });
  });
</script>
