---
import { MAIN_NAV, WORK_CATEGORIES } from "../lib/nav";
import { relativeHref } from "../lib/href";

interface Props {
  current?: string;
}
const { current } = Astro.props;
const here = Astro.url.pathname;
const currentSeries = WORK_CATEGORIES.find((c) => here.startsWith(c.href))?.series;
// 특정 시리즈(블라인드/설치/멀티슬라이드/회화) 및 그 상세 페이지에서만 드롭다운을
// 고정으로 펼쳐 현재 시리즈를 강조한다. Works 개요("20세기, 라는 소년" = /works/)는
// 예외로 currentSeries 가 없어 드롭다운이 접힌 상태가 기본이다.
const onWorks = !!currentSeries;
---

<nav class="nav" aria-label="주 메뉴">
  <ul>
    {
      MAIN_NAV.map((item) => {
        const isCurrent = current && item.href.startsWith(current);
        const hasDropdown = item.label === "WORKS";
        return (
          <li class:list={["nav-item", { "has-dropdown": hasDropdown, pinned: hasDropdown && onWorks }]}>
            <a
              href={relativeHref(item.href, here)}
              aria-current={isCurrent ? "page" : undefined}
              aria-expanded={hasDropdown ? "false" : undefined}
            >
              {item.label}
            </a>
            {hasDropdown && (
              <div class="dropdown" aria-label="작업 카테고리">
                <ul>
                  {WORK_CATEGORIES.map((cat) => (
                    <li>
                      <a
                        class:list={["tab", { active: currentSeries === cat.series }]}
                        href={relativeHref(cat.href, here)}
                      >
                        {cat.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        );
      })
    }
  </ul>
</nav>

<style>
  .nav ul {
    display: flex;
    gap: 36px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: calc(var(--fs-nav) + 0.5px);
  }
  .nav-item {
    /* 데스크탑: static → 드롭다운이 헤더 콘텐츠(.header-inner) 기준으로 배치되어
       좌우 끝이 본문 좌우 끝과 정렬된다. (모바일에서는 relative 로 복원) */
    position: static;
  }
  .nav a {
    color: var(--color-nav-default);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .nav a:hover,
  .nav a:focus-visible {
    color: var(--color-nav-hover);
    text-decoration: none;
  }
  .nav a:active,
  .nav a[aria-current="page"] {
    color: var(--color-nav-pressed);
  }

  /* ── WORKS 드롭다운 ── */
  .dropdown {
    position: absolute;
    top: 100%;
    /* 좌우를 헤더 콘텐츠 열 양끝에 앵커 → 본문 좌우 끝과 정렬, 탭은 균등 확장 */
    left: 0;
    right: 0;
    /* 드롭다운 상단 오프셋 */
    padding-top: 7px;
    padding-bottom: var(--space-2);
    /* 스크롤 시 드롭다운 뒤 흰 배경이 중간에 끊겨 보이지 않도록, 드롭다운
       자체에 흰 배경을 주어 헤더 배경과 이어지고 드롭다운 아래에서 끝나게 함 */
    background: var(--color-bg);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    /* 전환 없이 즉시 표시/숨김 → 전체 폭 흰 프레임과 타이밍 완전 일치 */
    white-space: nowrap;
    z-index: 100;
  }
  .nav-item.has-dropdown:hover .dropdown,
  .nav-item.has-dropdown:focus-within .dropdown,
  .nav-item.has-dropdown.open .dropdown,
  .nav-item.has-dropdown.pinned .dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  .nav-item.has-dropdown > a {
    padding-bottom: var(--space-2);
    margin-bottom: calc(-1 * var(--space-2));
  }
  .dropdown ul {
    display: flex;
    gap: 3px;
    list-style: none;
    margin: 0;
    padding: 0;
    /* 드롭다운 폭(JS로 WORKS~콘텐츠 우측 끝)에 맞춰 탭이 균등 분배되도록 */
    width: 100%;
  }
  .dropdown .tab {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    /* 고정 폭 대신 균등 분배 → 오른쪽 끝이 본문 그리드 우측 라인에 맞음 */
    flex: 1;
    min-width: 0;
    height: 18px;
    /* 좌우 내부 패딩 각 +1px (좌 4→5, 우 0→1) */
    padding: 0 1px 0 5px;
    background: var(--color-tab-bg);
    color: var(--color-tab-text);
    font-family: var(--font-display);
    /* 현재보다 1px 작게 + 아주 약간 얇게 */
    font-weight: 450;
    font-size: calc(var(--fs-tab) - 1px);
    letter-spacing: normal;
    transition: background 0.1s, color 0.1s;
    white-space: nowrap;
  }
  .dropdown .tab:hover {
    background: var(--color-tab-bg-active);
    color: var(--color-tab-text-active);
    text-decoration: none;
  }
  .dropdown .tab.active {
    background: var(--color-tab-bg-active);
    color: var(--color-tab-text-active);
  }

  /* ── 모바일 (768px 이하): 로고 아래 인라인 네비게이션 ── */
  @media (max-width: 768px) {
    .nav {
      width: 100%;
    }
    .nav ul {
      gap: var(--space-4);
      font-size: 13px;
      flex-wrap: wrap;
    }
    /* 모바일에선 드롭다운을 WORKS 항목 기준으로 (좌우 전체폭 앵커 해제) */
    .nav-item {
      position: relative;
    }

    /* WORKS 드롭다운: 탭하면 아래로 펼쳐지되, absolute 로 띄워 나머지 nav 항목
       (ESSAY/C.V./CONTACT) 위치가 밀리지 않도록 한다. (position/배경은 기본값 상속) */
    .dropdown {
      right: auto;
      padding-top: var(--space-2);
      white-space: normal;
    }
    /* 기본은 접힘, WORKS 항목을 탭해 .open이 되면 펼쳐짐 */
    .nav-item.has-dropdown .dropdown {
      display: none;
    }
    .nav-item.has-dropdown.open .dropdown,
    .nav-item.has-dropdown.pinned .dropdown {
      display: block;
    }
    .nav-item.has-dropdown > a {
      padding-bottom: 0;
      margin-bottom: 0;
    }
    .dropdown ul {
      flex-direction: column;
      gap: var(--space-2);
      padding-top: var(--space-2);
    }
    .dropdown .tab {
      width: auto;
      height: auto;
      padding: var(--space-1) var(--space-2);
      font-size: 13px;
    }
  }
</style>

<script>
  // WORKS 탭을 클릭하면 hover 상태가 아니어도 드롭다운이 펼쳐진 채 유지된다.
  // (모바일·데스크탑 공통) 첫 클릭은 링크 이동 대신 드롭다운을 열고, 이미 열려
  // 있으면 그대로 WORKS 인덱스로 이동한다.
  const CLOSE_DELAY = 800; // hover 후 마우스가 벗어나도 유지되는 시간(ms)
  const MOBILE = "(max-width: 768px)";
  const navEl = document.querySelector<HTMLElement>(".nav");

  // 모바일: 드롭다운은 absolute 라 흐름을 밀지 않으므로, 열린 동안 그 높이만큼
  // .nav 아래 여백을 만들어 본문이 드롭다운 아래로 내려가 겹치지 않게 한다.
  const reserveSpace = (item: HTMLElement) => {
    if (!navEl) return;
    const dd = item.querySelector<HTMLElement>(".dropdown");
    if (window.matchMedia(MOBILE).matches && item.classList.contains("open") && dd) {
      navEl.style.marginBottom = `${dd.offsetHeight}px`;
    } else {
      navEl.style.marginBottom = "";
    }
  };

  document.querySelectorAll<HTMLElement>(".nav-item.has-dropdown").forEach((item) => {
    const trigger = item.querySelector<HTMLAnchorElement>(":scope > a");
    if (!trigger) return;

    const open = () => {
      item.classList.add("open");
      trigger.setAttribute("aria-expanded", "true");
      reserveSpace(item);
    };
    const close = () => {
      item.classList.remove("open");
      trigger.setAttribute("aria-expanded", "false");
      reserveSpace(item);
    };

    trigger.addEventListener("click", (e) => {
      if (!item.classList.contains("open")) {
        e.preventDefault();
        open();
      }
    });

    // hover 진입 시 즉시 열고, 벗어나면 CLOSE_DELAY 후 닫아 Paintings 까지
    // 이동할 여유를 준다. 다시 진입하면 닫힘을 취소한다.
    let closeTimer: number | undefined;
    item.addEventListener("mouseenter", () => {
      clearTimeout(closeTimer);
      open();
    });
    item.addEventListener("mouseleave", () => {
      clearTimeout(closeTimer);
      closeTimer = window.setTimeout(close, CLOSE_DELAY);
    });
  });

  // 바깥 영역을 클릭하면 드롭다운 닫기
  document.addEventListener("click", (e) => {
    document.querySelectorAll<HTMLElement>(".nav-item.has-dropdown.open").forEach((item) => {
      if (!item.contains(e.target as Node)) {
        item.classList.remove("open");
        item.querySelector<HTMLAnchorElement>(":scope > a")?.setAttribute("aria-expanded", "false");
        reserveSpace(item);
      }
    });
  });

  // 화면 크기가 바뀌면 예약 여백을 다시 계산 (데스크탑 전환 시 제거)
  window.addEventListener("resize", () => {
    document.querySelectorAll<HTMLElement>(".nav-item.has-dropdown").forEach(reserveSpace);
  });
</script>
