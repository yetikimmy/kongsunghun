---
import { MAIN_NAV, WORK_CATEGORIES } from "../lib/nav";
import { relativeHref } from "../lib/href";

interface Props {
  current?: string;
}
const { current } = Astro.props;
const here = Astro.url.pathname;
const currentSeries = WORK_CATEGORIES.find((c) => here.startsWith(c.href))?.series;
---

<!-- 햄버거 버튼: 모바일에서만 표시 -->
<button class="hamburger" aria-label="메뉴 열기" aria-expanded="false" aria-controls="nav-menu">
  ☰
</button>

<nav class="nav" id="nav-menu" aria-label="주 메뉴">
  <!-- 모바일 닫기 버튼 -->
  <button class="nav-close" aria-label="메뉴 닫기">✕</button>
  <ul>
    {
      MAIN_NAV.map((item) => {
        const isCurrent = current && item.href.startsWith(current);
        const hasDropdown = item.label === "WORKS";
        return (
          <li class:list={["nav-item", { "has-dropdown": hasDropdown }]}>
            <a
              href={relativeHref(item.href, here)}
              aria-current={isCurrent ? "page" : undefined}
            >
              {item.label}
            </a>
            {hasDropdown && (
              <div class="dropdown" aria-label="작업 카테고리">
                <ul>
                  {WORK_CATEGORIES.map((cat) => (
                    <li>
                      <a
                        class:list={["tab", { active: currentSeries === cat.series }]}
                        href={relativeHref(cat.href, here)}
                      >
                        {cat.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        );
      })
    }
  </ul>
</nav>

<!-- 모바일 오버레이 배경 -->
<div class="nav-overlay" aria-hidden="true"></div>

<style>
  /* ── 데스크탑 기본 ── */
  .hamburger {
    display: none;
  }
  .nav-close {
    display: none;
  }
  .nav-overlay {
    display: none;
  }

  .nav ul {
    display: flex;
    gap: 36px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-nav);
  }
  .nav-item {
    position: relative;
  }
  .nav a {
    color: var(--color-nav-default);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .nav a:hover,
  .nav a:focus-visible {
    color: var(--color-nav-hover);
    text-decoration: none;
  }
  .nav a:active,
  .nav a[aria-current="page"] {
    color: var(--color-nav-pressed);
  }

  /* ── WORKS 드롭다운 ── */
  .dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    padding-top: var(--space-2);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.15s ease;
    white-space: nowrap;
    z-index: 100;
  }
  .nav-item.has-dropdown:hover .dropdown,
  .nav-item.has-dropdown:focus-within .dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  .nav-item.has-dropdown > a {
    padding-bottom: var(--space-2);
    margin-bottom: calc(-1 * var(--space-2));
  }
  .dropdown ul {
    display: flex;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .dropdown .tab {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 152px;
    height: 18px;
    padding: 0;
    background: var(--color-tab-bg);
    color: var(--color-tab-text);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--fs-tab);
    letter-spacing: normal;
    transition: background 0.1s, color 0.1s;
    white-space: nowrap;
  }
  .dropdown .tab:hover {
    background: var(--color-tab-bg-active);
    color: var(--color-tab-text-active);
    text-decoration: none;
  }
  .dropdown .tab.active {
    background: var(--color-tab-bg-active);
    color: var(--color-tab-text-active);
  }

  /* ── 모바일 (768px 미만) ── */
  @media (max-width: 768px) {
    .hamburger {
      display: flex;
      align-items: center;
      justify-content: center;
      background: none;
      border: none;
      cursor: pointer;
      font-size: 20px;
      color: var(--color-nav-default);
      padding: var(--space-1);
      line-height: 1;
      margin-left: auto;
    }

    .nav {
      position: fixed;
      top: 0;
      right: 0;
      width: 240px;
      height: 100vh;
      background: var(--color-bg);
      z-index: 200;
      padding: var(--space-5) var(--space-4);
      transform: translateX(100%);
      transition: transform 0.25s ease;
      box-shadow: -4px 0 24px rgba(0,0,0,0.08);
    }
    .nav.open {
      transform: translateX(0);
    }

    .nav-close {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      width: 100%;
      background: none;
      border: none;
      cursor: pointer;
      font-size: 18px;
      color: var(--color-nav-default);
      padding: 0;
      margin-bottom: var(--space-5);
    }

    .nav-overlay {
      display: block;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.3);
      z-index: 150;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s ease;
    }
    .nav-overlay.open {
      opacity: 1;
      pointer-events: auto;
    }

    .nav ul {
      flex-direction: column;
      gap: var(--space-4);
      font-size: 16px;
    }

    /* 모바일에서 WORKS 드롭다운: 항상 표시 */
    .dropdown {
      position: static;
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      padding-top: var(--space-2);
      transition: none;
    }
    .nav-item.has-dropdown > a {
      padding-bottom: 0;
      margin-bottom: 0;
    }
    .dropdown ul {
      flex-direction: column;
      gap: var(--space-2);
    }
    .dropdown .tab {
      width: auto;
      height: auto;
      padding: var(--space-1) var(--space-2);
      font-size: 14px;
      justify-content: flex-start;
    }
  }
</style>

<script>
  const hamburger = document.querySelector<HTMLButtonElement>('.hamburger');
  const navMenu = document.querySelector<HTMLElement>('#nav-menu');
  const navClose = document.querySelector<HTMLButtonElement>('.nav-close');
  const overlay = document.querySelector<HTMLElement>('.nav-overlay');

  function openMenu() {
    navMenu?.classList.add('open');
    overlay?.classList.add('open');
    hamburger?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }
  function closeMenu() {
    navMenu?.classList.remove('open');
    overlay?.classList.remove('open');
    hamburger?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  hamburger?.addEventListener('click', openMenu);
  navClose?.addEventListener('click', closeMenu);
  overlay?.addEventListener('click', closeMenu);

  // ESC 키로 닫기
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });
</script>
