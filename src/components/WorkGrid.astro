---
import { relativeHref } from "../lib/href";
import type { WorkGroup } from "../lib/works";

interface Props {
  groups: WorkGroup[];
  columns?: number;
  /** "grid" = 4:3 thumbnail grid, "square-grid" = square thumbnail grid, "list" = horizontal image+text rows */
  layout?: "grid" | "square-grid" | "list";
  showLangToggle?: boolean;
}
const { groups, columns = 3, layout = "grid", showLangToggle = false } = Astro.props;
const here = Astro.url.pathname;
const isSquare = layout === "square-grid" || showLangToggle;
---

{(layout === "grid" || layout === "square-grid") && (
  <ul class="grid" role="list" style={`--cols: ${columns}`}>
    {groups.map((group) => {
      const cover = group.cover;
      const count = group.slides.length;
      return (
        <li class="card">
          <a href={relativeHref(`/works/${group.series}/${group.slug}/`, here)}>
            <div class:list={["thumb", { "thumb--square": isSquare }]}>
              {cover ? (
                <img
                  src={relativeHref(cover.src, here)}
                  alt={cover.alt}
                  loading="lazy"
                  onerror="this.style.display='none'"
                />
              ) : (
                <span class="placeholder" aria-hidden="true" />
              )}
              {count > 1 && <span class="count" aria-label={`이미지 ${count}장`}>{count}</span>}
            </div>
            {isSquare ? (
              <div class="card-title-area">
                <p class="card-title card-title--center" data-lang="ko">{group.titleKo}</p>
                <p class="card-title card-title--center" data-lang="en" hidden={true}>{group.titleEn}</p>
              </div>
            ) : (
              <>
                <h3 class="card-title">{group.titleEn}</h3>
                <p class="caption">
                  {group.titleKo}
                  {group.year ? ` · ${group.year}` : ""}
                </p>
              </>
            )}
          </a>
        </li>
      );
    })}
  </ul>
)}

{layout === "list" && (
  <ul class="paint-list" role="list">
    {groups.map((group) => {
      const cover = group.cover;
      return (
        <li class="paint-item">
          <a href={relativeHref(`/works/${group.series}/${group.slug}/`, here)}>
            <div class="paint-thumb">
              {cover ? (
                <img
                  src={relativeHref(cover.src, here)}
                  alt={cover.alt}
                  loading="lazy"
                  onerror="this.style.display='none'"
                />
              ) : (
                <span class="placeholder" aria-hidden="true" />
              )}
            </div>
            <div class="paint-info">
              <p class="paint-title">{group.titleKo}</p>
              <p class="paint-meta">
                {group.titleKo !== group.titleEn ? group.titleEn : ""}
                {group.year ? (group.titleKo !== group.titleEn ? ` (${group.year})` : String(group.year)) : ""}
              </p>
            </div>
          </a>
        </li>
      );
    })}
  </ul>
)}

<style>
  /* ── standard grid ── */
  .grid {
    display: grid;
    grid-template-columns: repeat(var(--cols, 3), 1fr);
    gap: var(--space-5) var(--space-4);
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
  }
  .thumb {
    position: relative;
    aspect-ratio: 4 / 3;
    background: #f2f2f2;
    overflow: hidden;
  }
  .thumb--square {
    aspect-ratio: 1 / 1;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .placeholder {
    display: block;
    width: 100%;
    height: 100%;
  }
  .count {
    position: absolute;
    right: var(--space-2);
    bottom: var(--space-2);
    min-width: 18px;
    height: 18px;
    padding: 0 6px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.7);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 10px;
    border-radius: 9px;
  }
  .card-title-area {
    display: grid;
  }
  .card-title-area > * {
    grid-area: 1 / 1;
  }
  /* keep both lang titles in-flow so card height never shifts on toggle */
  .card-title-area [hidden] {
    display: block !important;
    visibility: hidden;
  }
  .card-title {
    font-family: var(--font-body);
    font-size: var(--fs-body);
    color: #656565;
    margin-top: var(--space-2);
    line-height: 15px;
  }
  .card-title--center {
    text-align: center;
  }

  /* ── Paintings horizontal list ── */
  .paint-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 38px 92px;
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
  }
  .paint-item a {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    text-decoration: none;
  }
  .paint-item a:hover .paint-title {
    text-decoration: underline;
  }
  .paint-thumb {
    flex: 0 0 196px;
    width: 196px;
    height: 158px;
    background: #f2f2f2;
    overflow: hidden;
  }
  .paint-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .paint-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-width: 0;
  }
  .paint-title {
    font-family: var(--font-body);
    font-size: var(--fs-body);
    line-height: 16px;
    color: var(--color-fg);
    margin: 0;
  }
  .paint-meta {
    font-family: var(--font-body);
    font-size: var(--fs-body);
    line-height: 16px;
    color: #656565;
    margin: 0;
  }

  /* ── responsive ── */
  @media (max-width: 1024px) {
    .grid {
      grid-template-columns: repeat(min(var(--cols, 3), 2), 1fr);
    }
    .paint-list {
      grid-template-columns: 1fr;
      gap: 24px 0;
    }
  }
  @media (max-width: 480px) {
    .grid {
      grid-template-columns: 1fr;
      gap: var(--space-4) 0;
    }
  }
</style>
