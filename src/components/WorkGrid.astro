---
import { relativeHref } from "../lib/href";
import type { WorkGroup } from "../lib/works";

interface Props {
  groups: WorkGroup[];
  columns?: number;
}
const { groups, columns = 3 } = Astro.props;
const here = Astro.url.pathname;
---

<ul class="grid" role="list" style={`--cols: ${columns}`}>
  {
    groups.map((group) => {
      const cover = group.cover;
      const count = group.slides.length;
      return (
        <li class="card">
          <a href={relativeHref(`/works/${group.series}/${group.slug}/`, here)}>
            <div class="thumb">
              {cover ? (
                <img
                  src={relativeHref(cover.src, here)}
                  alt={cover.alt}
                  loading="lazy"
                  onerror="this.style.display='none'"
                />
              ) : (
                <span class="placeholder" aria-hidden="true" />
              )}
              {count > 1 && <span class="count" aria-label={`이미지 ${count}장`}>{count}</span>}
            </div>
            <h3 class="card-title">{group.titleEn}</h3>
            <p class="caption">
              {group.titleKo}
              {group.year ? ` · ${group.year}` : ""}
            </p>
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(var(--cols, 3), 1fr);
    gap: var(--space-5) var(--space-4);
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
  }
  .thumb {
    position: relative;
    aspect-ratio: 4 / 3;
    background: #f2f2f2;
    overflow: hidden;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .placeholder {
    display: block;
    width: 100%;
    height: 100%;
  }
  .count {
    position: absolute;
    right: var(--space-2);
    bottom: var(--space-2);
    min-width: 18px;
    height: 18px;
    padding: 0 6px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.7);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 10px;
    border-radius: 9px;
  }
  .card-title {
    font-size: var(--fs-body);
    margin-top: var(--space-2);
  }
  @media (max-width: 1024px) {
    .grid {
      grid-template-columns: repeat(min(var(--cols, 3), 2), 1fr);
    }
  }
  @media (max-width: 480px) {
    .grid {
      grid-template-columns: 1fr;
      gap: var(--space-4) 0;
    }
  }
</style>
