---
import type { CollectionEntry } from "astro:content";
import { relativeHref } from "../lib/href";

interface Props {
  works: CollectionEntry<"works">[];
}
const { works } = Astro.props;
const here = Astro.url.pathname;
---

<ul class="grid" role="list">
  {
    works.map((work) => {
      const cover = work.data.images[0];
      return (
        <li class="card">
          <a href={relativeHref(`/works/${work.data.series}/${work.data.slug}/`, here)}>
            <div class="thumb">
              {cover ? (
                <img
                  src={relativeHref(cover.src, here)}
                  alt={cover.alt}
                  loading="lazy"
                  onerror="this.style.display='none'"
                />
              ) : (
                <span class="placeholder" aria-hidden="true" />
              )}
            </div>
            <h3 class="card-title">{work.data.titleEn}</h3>
            <p class="caption">
              {work.data.titleKo}
              {work.data.year ? ` · ${work.data.year}` : ""}
            </p>
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5) var(--space-4);
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
  }
  .thumb {
    aspect-ratio: 4 / 3;
    background: #f2f2f2;
    overflow: hidden;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .placeholder {
    display: block;
    width: 100%;
    height: 100%;
  }
  .card-title {
    font-size: var(--fs-body);
    margin-top: var(--space-2);
  }
  @media (max-width: 768px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-4) var(--space-3);
    }
  }
</style>
