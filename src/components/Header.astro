---
import Navigation from "./Navigation.astro";
import Logo from "./Logo.astro";
import { relativeHref } from "../lib/href";

interface Props {
  current?: string;
  invert?: boolean;
}
const { current, invert = false } = Astro.props;
const here = Astro.url.pathname;
---

<header class:list={["header", { invert }]}>
  <div class="container header-inner">
    <a class="logo" href={relativeHref("/", here)}><Logo /></a>
    <Navigation current={current} />
  </div>
</header>

<style>
  /* 회색 라인 제거 · 스크롤 시 상단 고정 */
  .header {
    border-bottom: none;
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-bg);
    /* 드롭다운 배경(box-shadow)이 닫힐 때 함께 자연스럽게 사라지도록 */
    transition: box-shadow 0.25s ease;
  }
  .header.invert {
    background: var(--color-bg-invert);
    color: var(--color-fg-invert);
  }
  .header-inner {
    display: flex;
    /* 로고(큰 서체)와 네비게이션(작은 서체)의 글자 베이스라인을 일직선으로 정렬 */
    align-items: baseline;
    justify-content: flex-start;
    gap: 58px;
    /* 상단 여백 (로고·네비게이션 윗부분) */
    padding-top: calc(var(--space-4) + 17px);
    padding-bottom: var(--space-4);
  }
  .logo {
    font-family: var(--font-mono);
    font-size: 28px;
    font-weight: 400;
    letter-spacing: 0.12em;
    white-space: nowrap;
    color: #000000;
    text-decoration: none;
  }
  .invert .logo { color: #ffffff; }

  /* ── 모바일: 로고 위 / 네비게이션 아래로 세로 배치 ── */
  @media (max-width: 768px) {
    .header-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
      /* 상단 여백 */
      padding-top: calc(var(--space-3) + 17px);
      padding-bottom: var(--space-3);
    }
    .logo {
      font-size: clamp(16px, 5vw, 22px);
    }
  }
</style>
