---
import Navigation from "./Navigation.astro";
import { LOGO_LABEL } from "../lib/nav";
import { relativeHref } from "../lib/href";

interface Props {
  current?: string;
  invert?: boolean;
}
const { current, invert = false } = Astro.props;
const here = Astro.url.pathname;
---

<header class:list={["header", { invert }]}>
  <div class="container header-inner">
    <a class="logo" href={relativeHref("/", here)}>{LOGO_LABEL}</a>
    <Navigation current={current} />
  </div>
</header>

<style>
  /* 회색 라인 제거 */
  .header {
    border-bottom: none;
  }
  .header.invert {
    background: var(--color-bg-invert);
    color: var(--color-fg-invert);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
  }
  .logo {
    font-family: var(--font-mono);
    font-size: 28px;
    font-weight: 400;
    letter-spacing: 0.12em;
    white-space: nowrap;
    color: #000000;
    text-decoration: none;
  }
  .invert .logo { color: #ffffff; }
  @media (max-width: 768px) {
    .header-inner {
      flex-direction: row;
      align-items: center;
      gap: var(--space-2);
    }
    .logo {
      font-size: clamp(14px, 4vw, 20px);
    }
  }
</style>
