---
import Navigation from "./Navigation.astro";
import { LOGO_LABEL } from "../lib/nav";
import { relativeHref } from "../lib/href";

interface Props {
  current?: string;
  invert?: boolean;
}
const { current, invert = false } = Astro.props;
const here = Astro.url.pathname;
---

<header class:list={["header", { invert }]}>
  <div class="container header-inner">
    <a class="logo" href={relativeHref("/", here)}>{LOGO_LABEL}</a>
    <Navigation current={current} />
  </div>
</header>

<style>
  .header {
    border-bottom: 1px solid var(--color-line);
  }
  .header.invert {
    background: var(--color-bg-invert);
    color: var(--color-fg-invert);
    border-bottom-color: transparent;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
  }
  .logo {
    font-family: var(--font-mono);
    font-size: var(--fs-logo);
    font-weight: 600;
    letter-spacing: var(--ls-logo);
    white-space: nowrap;
  }
  @media (max-width: 768px) {
    .header-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }
    .logo {
      font-size: 20px;
    }
  }
</style>
