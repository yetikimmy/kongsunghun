---
import { relativeHref } from "../lib/href";
import type { WorkGroup } from "../lib/works";

interface Props {
  group: WorkGroup;
  backHref: string;
  singlePage?: boolean;
}
const { group, backHref, singlePage = false } = Astro.props;
const here = Astro.url.pathname;
const rel = (p: string) => relativeHref(p, here);

const slides = group.slides;
const total = slides.length;
const multiple = total > 1;
---

<article class="detail" data-total={total}>
  <!-- 좌측: 작품 정보 -->
  <div class="detail-info">
    {singlePage ? (
      /* Single-page series (Blind Work): fixed panel, no data-index → stays visible on every slide.
         Title shown as "BLIND WORK"; no per-slide meta line, description directly below. */
      <div class="info-panel">
        <h1 class="title">
          <span class="title-ko-line">개념 간의 교집합</span>
          <span class="title-en-line">INTERSECTION OF CONCEPTS</span>
        </h1>
        {(slides[0]?.descriptionKo || slides[0]?.descriptionEn) && (
          <div class="body-text">
            {slides[0].descriptionKo && <p>{slides[0].descriptionKo}</p>}
            {slides[0].descriptionEn && <p lang="en">{slides[0].descriptionEn}</p>}
          </div>
        )}
      </div>
    ) : (
      <>
        {/* Group title is fixed — does not change when advancing slides */}
        <h1 class="title">
          {group.titleKo && <span class="title-line">{group.titleKo}</span>}
          {group.titleEn && group.titleEn !== group.titleKo && <span class="title-line">{group.titleEn}</span>}
        </h1>
        {slides.map((s, i) => (
          <div class="info-slide" data-index={i} hidden={i !== 0}>
            {(s.descriptionKo || s.descriptionEn) && (
              <div class="body-text">
                {s.descriptionKo && <p>{s.descriptionKo}</p>}
                {s.descriptionEn && <p lang="en">{s.descriptionEn}</p>}
              </div>
            )}
          </div>
        ))}
      </>
    )}
  </div>

  <!-- 우측: 이미지 carousel -->
  <div class="detail-media">
    {multiple && (
      <div class="pager">
        <button class="pager-btn prev" aria-label="이전 이미지" disabled>Prev</button>
        <span class="pager-pos"><span class="pager-current">1</span><span class="pager-slash">/</span>{total}</span>
        <button class="pager-btn next" aria-label="다음 이미지">Next</button>
      </div>
    )}

    <div class="frame" data-multiple={multiple ? "true" : "false"}>
      {slides.map((s, i) => (
        <figure class="media-slide" data-index={i} hidden={i !== 0}>
          {s.src ? (
            <img
              src={rel(s.src)}
              alt={s.alt}
              width={s.width}
              height={s.height}
              loading="eager"
              fetchpriority={i === 0 ? "high" : "low"}
              onerror="this.closest('figure').classList.add('img-missing')"
            />
          ) : (
            <span class="placeholder" aria-hidden="true" />
          )}
        </figure>
      ))}
      {multiple && (
        <>
          <button class="zone zone-prev" aria-label="이전 이미지" tabindex="-1"></button>
          <button class="zone zone-next" aria-label="다음 이미지" tabindex="-1"></button>
        </>
      )}
    </div>

    {slides.map((s, i) => (
      s.caption && (
        <p class="caption media-caption" data-index={i} hidden={i !== 0}>{s.caption}</p>
      )
    ))}
  </div>

  <a class="back-link" href={rel(backHref)}><span class="back-chevron" aria-hidden="true"></span>목록으로</a>
</article>

<style>
  .detail {
    display: grid;
    /* 고정 폭 컬럼 — 뷰포트에 따라 변하지 않도록 vw 대신 px 사용 */
    grid-template-columns: minmax(0, 410px) minmax(0, 496px);
    gap: var(--space-6);
    align-items: start;
  }

  /* ── 좌측 정보 ── */
  .title {
    font-family: var(--font-display);
    font-size: clamp(18px, 2.4vw, 28px);
    font-weight: 600;
    line-height: 1.25;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .title-ko-line,
  .title-en-line,
  .title-line {
    font-size: clamp(18px, 2.4vw, 28px);
    font-weight: 600;
    font-family: var(--font-display);
  }
  .meta {
    font-size: var(--fs-caption);
    color: var(--color-muted);
    margin-top: var(--space-3);
  }
  .body-text {
    margin-top: var(--space-4);
    color: #8c8c8c;
    font-size: 13px;
    line-height: calc(var(--lh-body) + 1px);
    /* 한글 어절(단어)이 줄바꿈으로 잘리지 않도록; 긴 영문 단어만 예외적으로 분리 */
    word-break: keep-all;
    overflow-wrap: break-word;
  }
  .body-text p + p {
    margin-top: var(--space-3);
  }

  /* ── 우측 이미지 carousel ── */
  .detail-media {
    display: flex;
    flex-direction: column;
  }
  .pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4px;
    font-family: var(--font-mono);
    font-size: calc(var(--fs-nav) - 2px);
  }
  .pager-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
    font-size: inherit;
    /* Prev / Next 자간을 아주 살짝 좁게 */
    letter-spacing: -0.01em;
    /* 활성 버튼이 비활성처럼 보이지 않도록 조금 더 진한 회색으로 통일 */
    color: #999999;
    padding: 0;
    transition: color 0.15s;
  }
  .pager-btn:hover:not(:disabled) {
    color: var(--color-nav-pressed);
  }
  .pager-btn:disabled {
    color: var(--color-line);
    cursor: default;
  }
  .pager-pos {
    /* 본문 텍스트와 동일한 회색, 페이저보다 1px 작게 */
    color: #8c8c8c;
    font-size: calc(var(--fs-nav) - 3px);
  }
  /* "/" 양옆 간격을 일반 스페이스보다 약간 줄임 */
  .pager-slash {
    margin: 0 2px;
  }

  .frame {
    position: relative;
  }
  .media-slide {
    margin: 0;
  }
  .media-slide img {
    width: 100%;
    height: auto;
    display: block;
  }
  .media-slide.img-missing {
    aspect-ratio: 4 / 3;
    background: #f2f2f2;
  }
  .media-slide.img-missing img {
    display: none;
  }
  .placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    background: #f2f2f2;
  }

  /* 이미지 좌우 클릭 영역 */
  .zone {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    border: none;
    background: transparent;
    cursor: pointer;
    padding: 0;
  }
  .zone-prev { left: 0; cursor: w-resize; }
  .zone-next { right: 0; cursor: e-resize; }

  .media-caption {
    margin-top: 8px;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    font-style: normal;
    line-height: 14px;
    color: #9e9e9e;
    word-break: break-word;
  }

  .back-link {
    grid-column: 1 / -1;
    margin-top: var(--space-6);
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-mono);
    font-size: calc(var(--fs-nav) - 1px);
    /* 이미지 네비게이션 버튼과 동일한 진한 회색 */
    color: #999999;
    transition: color 0.15s;
  }
  /* 왼쪽 꺾쇠(chevron) 아이콘 — 글자 획과 비슷하게 얇게 */
  .back-chevron {
    width: 6px;
    height: 6px;
    border-left: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: rotate(45deg);
  }
  .back-link:hover {
    color: var(--color-nav-pressed);
    text-decoration: none;
  }

  /* ── 모바일/태블릿: 1단 ── */
  @media (max-width: 900px) {
    .detail {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
    .detail-media {
      order: -1; /* 모바일에선 이미지를 위로 */
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".detail").forEach((detail) => {
    const total = Number(detail.dataset.total || "1");
    if (total <= 1) return;

    // 모든 슬라이드 이미지를 미리 디코드해 두어, 다음 이미지로 넘길 때
    // 흰 화면이 잠깐 뜨는 로딩 지연을 없앤다.
    detail.querySelectorAll<HTMLImageElement>(".media-slide img").forEach((img) => {
      if (img.decode) img.decode().catch(() => {});
    });

    const groups = {
      info: detail.querySelectorAll<HTMLElement>(".info-slide"),
      media: detail.querySelectorAll<HTMLElement>(".media-slide"),
      caption: detail.querySelectorAll<HTMLElement>(".media-caption"),
    };
    const prevBtn = detail.querySelector<HTMLButtonElement>(".pager-btn.prev");
    const nextBtn = detail.querySelector<HTMLButtonElement>(".pager-btn.next");
    const zonePrev = detail.querySelector<HTMLElement>(".zone-prev");
    const zoneNext = detail.querySelector<HTMLElement>(".zone-next");
    const currentEl = detail.querySelector<HTMLElement>(".pager-current");
    let current = 0;

    function show(n: number) {
      if (n < 0 || n >= total) return;
      [groups.info, groups.media, groups.caption].forEach((set) => {
        set.forEach((el) => {
          const idx = Number(el.dataset.index);
          el.hidden = idx !== n;
        });
      });
      current = n;
      if (currentEl) currentEl.textContent = String(current + 1);
      if (prevBtn) prevBtn.disabled = current === 0;
      if (nextBtn) nextBtn.disabled = current === total - 1;
    }

    prevBtn?.addEventListener("click", () => show(current - 1));
    nextBtn?.addEventListener("click", () => show(current + 1));
    zonePrev?.addEventListener("click", () => show(current - 1));
    zoneNext?.addEventListener("click", () => show(current + 1));

    // 키보드 좌우 화살표
    detail.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") show(current - 1);
      if (e.key === "ArrowRight") show(current + 1);
    });
  });
</script>
