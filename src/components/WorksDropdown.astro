---
import { WORK_CATEGORIES } from "../lib/nav";
import { relativeHref } from "../lib/href";

interface Props {
  currentSeries?: string;
}
const { currentSeries } = Astro.props;
const here = Astro.url.pathname;
---

<nav class="work-cats" aria-label="작업 카테고리">
  <ul>
    {
      WORK_CATEGORIES.map((cat) => (
        <li>
          <a
            href={relativeHref(cat.href, here)}
            aria-current={currentSeries === cat.series ? "page" : undefined}
          >
            {cat.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .work-cats ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-display);
    font-size: var(--fs-tab);
  }
  .work-cats a {
    display: flex;
    align-items: center;
    height: 18px;
    padding: 0 var(--space-1);
    background: var(--color-tab-bg);
    color: var(--color-tab-text);
    font-weight: 500;
    text-decoration: none;
  }
  .work-cats a:hover {
    color: var(--color-nav-pressed);
  }
  .work-cats a[aria-current="page"] {
    background: var(--color-tab-bg-active);
    color: var(--color-tab-text-active);
  }
  @media (max-width: 768px) {
    .work-cats ul {
      gap: var(--space-1);
    }
  }
</style>
