{
  "name": "kongsunghun-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Modernized static site for artist Kong Sung-hun (Astro). Legacy HTML preserved at repo root.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run postbuild",
    "postbuild": "node scripts/relativize-asset-paths.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "extract:legacy": "node scripts/extract-legacy-works.mjs",
    "extract:pages": "node scripts/extract-legacy-pages.mjs",
    "import:works": "node scripts/import-legacy-works-to-content.mjs --clean"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource/pretendard": "^5.2.5",
    "astro": "^5.7.0",
    "iconv-lite": "^0.7.2",
    "pretendard": "^1.3.9"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "typescript": "^5.8.0"
  }
}
